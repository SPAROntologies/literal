[
  {
    "@id": "http://www.essepuntato.it/2010/06/literalreification/hasSameLiteralValueAs",
    "@type": [
      "http://www.w3.org/2002/07/owl#TransitiveProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#SymmetricProperty"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-resource\n        literal:hasLiteral :my-literal .\n\n    :my-literal a literal:Literal ;\n        literal:hasLiteralValue \"My Resource\" ;\n        literal:hasSameLiteralValueAs :my-other-literal .\n\n    :my-other-literal a literal:Literal ;\n        literal:hasLiteralValue \"My Resource\" .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The relation between a reified literal and another one that has the same literal value."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.essepuntato.it/2010/06/literalreification/Literal"
      }
