    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/SPAROntologies/literal/blob/master/docs/cq.md"
      }
    ],
    "http://purl.org/ontology/bibo/doi": [
      {
        "@value": "https://doi.org/10.25504/FAIRsharing.d7f0a9"
      }
    ],
    "http://purl.org/ontology/bibo/status": [
      {
        "@id": "http://purl.org/ontology/bibo/status/published"
      }
    ],
    "http://purl.org/vocab/vann/changes": [
      {
        "@language": "en",
        "@value": "\n* **v1.1.0**: \nAdded new documentation, including annotation properties (e.g., `bibo:doi`, `schema:codeRepository`, etc.), term properties (e.g., `vann:example`, `vs:term_status`, etc.), exemplary competency questions with their respective SPARQL queries, and a Grafoo diagram.\nChanged prefix from `litre:` to `literal:`.\n    "
      }
    ],
